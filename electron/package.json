{
  "name": "lord-and-grace-desktop",
  "version": "1.0.0",
  "description": "Lord & Grace storefront — Windows desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lordandgrace.store",
    "productName": "Lord & Grace",
    "win": {
      "target": "nsis",
      "icon": "../icons/icon-512.png"
    },
    "files": [
      "main.js",
      "../www/**/*"
    ]
  }
}
